# WorkforceOS Frontend Environment Variables
# Copy this file to .env or .env.local to configure Vite environment variables.

# Base URL for the WorkforceOS backend REST API
# - When running with the local Vite proxy or Docker Nginx reverse proxy: use /api (default)
# - When deploying frontend and backend to separate domains (e.g., Vercel + Render):
#   set this to the absolute backend URL with /api suffix, e.g.:
#   VITE_API_URL=https://api.yourproductiondomain.com/api
VITE_API_URL=/api
