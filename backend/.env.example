# WorkforceOS Backend Environment Variables
# Copy this file to .env and replace ALL placeholder values before deploying.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string using asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/workforceos

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_hex_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS & Trusted Hosts ────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (NO wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated trusted hostnames (prevents Host header injection)
TRUSTED_HOSTS=localhost,127.0.0.1

# ─── App Tuning ──────────────────────────────────────────────────────────────
# Number of Uvicorn worker processes per container
WORKERS=4
# Environment tag used in logging
APP_ENV=development
