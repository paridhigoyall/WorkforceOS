# ==============================================================================
# WorkforceOS Enterprise Full-Stack Deployment Environment Variables
# Copy this file to .env before deploying:
#   cp .env.example .env
# ==============================================================================

# ─── Database Configuration ───────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=workforceos
# PostgreSQL async connection string:
# Used by backend services and migrations.
DATABASE_URL=postgresql+asyncpg://postgres:generate_a_strong_database_password_here@postgres:5432/workforceos

# ─── Security & Authentication ────────────────────────────────────────────────
# Generate a cryptographically secure 64-byte hex secret:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change_this_to_a_cryptographically_secure_random_64_byte_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Network, CORS & Trusted Hosts ───────────────────────────────────────────
# Comma-separated list of allowed origins for browser CORS (no wildcards in production)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,https://yourdomain.com

# Comma-separated list of trusted Host headers (prevents Host header injection)
TRUSTED_HOSTS=localhost,127.0.0.1,nginx,yourdomain.com

# ─── Service Tuning ───────────────────────────────────────────────────────────
# Number of concurrent Uvicorn ASGI worker processes per replica
WORKERS=4
APP_ENV=production
RUN_MIGRATIONS=false
